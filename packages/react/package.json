{
  "name": "@il-address/react",
  "version": "1.0.0",
  "description": "Headless React hooks for Israeli city and street autocomplete",
  "license": "MIT",
  "keywords": ["israel", "address", "autocomplete", "react", "hebrew", "hooks"],
  "repository": {
    "type": "git",
    "url": "https://github.com/NirTatcher/il-address-autocomplete.git",
    "directory": "packages/react"
  },
  "homepage": "https://il-address-autocomplete.netlify.app",
  "bugs": {
    "url": "https://github.com/NirTatcher/il-address-autocomplete/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@il-address/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
