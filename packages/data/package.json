{
  "name": "@il-address/data",
  "version": "0.1.0",
  "description": "Israeli city and street data for @il-address/core",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./manifest.json": "./manifest.json",
    "./cities.json": "./generated/cities.json",
    "./streets/*.json": "./generated/streets/*.json",
    "./loader": {
      "types": "./generated/street-loader.d.ts",
      "import": "./generated/street-loader.js",
      "default": "./generated/street-loader.js"
    }
  },
  "files": [
    "generated",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "fetch:gov": "tsx scripts/fetch-gov-il.ts",
    "build": "tsx scripts/build.ts",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
