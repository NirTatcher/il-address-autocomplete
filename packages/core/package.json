{
  "name": "@il-address/core",
  "version": "1.0.0",
  "description": "Headless Israeli city and street autocomplete for JavaScript",
  "license": "MIT",
  "keywords": ["israel", "address", "autocomplete", "hebrew", "cities", "streets", "data.gov.il"],
  "repository": {
    "type": "git",
    "url": "https://github.com/NirTatcher/il-address-autocomplete.git",
    "directory": "packages/core"
  },
  "homepage": "https://il-address-autocomplete.netlify.app",
  "bugs": {
    "url": "https://github.com/NirTatcher/il-address-autocomplete/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@il-address/data": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
